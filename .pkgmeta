package-as: KitnEssentials

changelog-title: KitnEssentials

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Only tracked files need listing here — gitignored paths (References/,
# dev/docs/, editor configs, …) never reach the packager's clone. Tracked
# dev-tree files (incl. dev/Annotations/) are stripped solely by the `- dev`
# entry below.
ignore:
  - .pkgmeta
  - .github
  - .gitattributes
  - .gitignore
  - .luacheckrc
  - .busted
  - .luacov
  - dev
  - CHANGELOG.md
  - README.md


externals:
  Libs/AceAddon-3.0:
