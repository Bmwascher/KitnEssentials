package-as: KitnEssentials

changelog-title: KitnEssentials

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# The settings pages ship as their own load-on-demand addon, a sibling
# folder of KitnEssentials in the package, not a subfolder of it.
move-folders:
  KitnEssentials/KitnEssentials_Options: KitnEssentials_Options

# Only tracked files need listing here — gitignored paths (References/,
# dev/docs/, editor configs, …) never reach the packager's clone. Tracked
# dev-tree files (incl. dev/Annotations/) are stripped solely by the `- dev`
# entry below.
ignore:
  - .pkgmeta
  - .github
  - .gitattributes
  - .gitignore
  - .luacheckrc
  - .busted
  - .luacov
  - dev
  - CHANGELOG.md
  - README.md
  # Source art for the addon list icon. The icon itself ships as KES.tga --
  # cropped and sized for a square slot -- so the full-bleed original is dead
  # weight in the player zip.
  - Media/Icon/KES.png


# Every external is pinned to an exact commit or tag, and the tracked copy
# under Libs/ holds the same files, so the dev checkout runs what ships.
# Update both together: `pwsh dev/scripts/check-lib-updates.ps1` lists pins
# behind upstream, and its -Update mode moves a pin and rebuilds the copy.
externals:
  Libs/AceAddon-3.0:
    url: https://github.com/WoWUIDev/Ace3.git/AceAddon-3.0
    commit: 40f4cc1356ae7fcc0cf71fc0a19dc7d50d6ae6c2
  Libs/AceDB-3.0:
    url: https://github.com/WoWUIDev/Ace3.git/AceDB-3.0
    commit: 40f4cc1356ae7fcc0cf71fc0a19dc7d50d6ae6c2
