#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════════╗
# ║  dev/githooks/pre-push                                   ║
# ║  Local gate so bad code never reaches a pushed branch.   ║
# ╚══════════════════════════════════════════════════════════╝
#
# Opt in once (per clone / per worktree):
#     git config core.hooksPath dev/githooks
#
# Requires lua + busted + luacheck on PATH. On Windows, ensure the luarocks
# bin dir (e.g. %APPDATA%\luarocks\bin) is on PATH — see dev/README.md.
# Override a single push with:  git push --no-verify
set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root" || exit 1

# Buffer the pushed refs FIRST: git feeds one line per ref on stdin,
# consumable exactly once, and both the tag guard and the attestation
# check below need them (a second `while read` would see nothing).
pushed_refs=()
while IFS= read -r _line; do pushed_refs+=("$_line"); done

# Release-tag guard (blocking): a v* tag must point at the release commit —
# subject "vX.Y.Z: …". Tagging a merge/feature commit instead broke the
# naming convention for v1.17.0, v3.0.0, v3.0.3. Override a deliberate
# exception with: git push --no-verify
for _line in "${pushed_refs[@]}"; do
    read -r _lref _lsha _rref _rsha <<< "$_line"
    case "$_rref" in refs/tags/v*) ;; *) continue ;; esac
    # skip tag deletions (local sha is all zeros)
    case "$_lsha" in *[!0]*) ;; *) continue ;; esac
    tag="${_rref#refs/tags/}"
    subject="$(git log -1 --format=%s "$_lsha" 2>/dev/null)"
    case "$subject" in
        "$tag:"*) ;;
        *)
            echo "[pre-push] BLOCKED: $tag points at '$subject' — tag the release commit ('$tag: …') instead, or override with: git push --no-verify" >&2
            exit 1
            ;;
    esac
    # Second clause of the release invariant: the tagged commit must sit on main.
    if ! git merge-base --is-ancestor "$_lsha" refs/heads/main 2>/dev/null; then
        echo "[pre-push] BLOCKED: $tag targets a commit not on main — merge to main first, then tag. Override: git push --no-verify" >&2
        exit 1
    fi
done

# Attestation check (non-blocking, parallax 0.6.0): a main push whose range
# touches .lua/.xml should carry a multi-model-verify attestation for the
# pushed head — the SHA-bound review record written at final adjudication
# (fast-forward and merge matching rules documented in the verifier).
# Warn only: trivial direct-to-main pushes stay allowed by the family git
# rules, and dev-tooling/docs ranges are not filtered in.
parallax_verifier="$HOME/Documents/parallax/tools/verify-attestation.ps1"
if [ -f "$parallax_verifier" ]; then
    for _line in "${pushed_refs[@]}"; do
        read -r _lref _lsha _rref _rsha <<< "$_line"
        [ "$_rref" = "refs/heads/main" ] || continue
        case "$_lsha" in *[!0]*) ;; *) continue ;; esac
        range_touches=""
        case "$_rsha" in
            *[!0]*) range_touches="$(git diff --name-only "$_rsha".."$_lsha" -- '*.lua' '*.xml' 2>/dev/null | head -1)" ;;
            *) range_touches="first-push" ;;
        esac
        [ -n "$range_touches" ] || continue
        # powershell.exe needs Windows paths; cygpath ships with git-bash.
        win_verifier="$(cygpath -w "$parallax_verifier" 2>/dev/null || echo "$parallax_verifier")"
        win_root="$(cygpath -w "$repo_root" 2>/dev/null || echo "$repo_root")"
        if out="$(powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$win_verifier" -RepoRoot "$win_root" -LocalSha "$_lsha" 2>&1)"; then
            echo "[pre-push] attestation: $out"
        else
            echo "[pre-push] note (non-blocking): main push $_lsha touches .lua/.xml without a matching multi-model-verify attestation — $out (run mode diff + write-attestation.ps1, or ignore for a trivial change)" >&2
        fi
    done
fi

# AGENTS.md drift check (non-blocking): warn when Modules/ on disk and the
# AGENTS.md Structure block disagree, in either direction. AGENTS.md is
# gitignored, so read it from the working tree. Runs before the busted
# early-exit so the note always prints.
if [ -f AGENTS.md ] && [ -d Modules ]; then
    drift=0
    for d in Modules/*/; do
        name="$(basename "$d")"
        if ! grep -q "Modules/$name/" AGENTS.md; then
            echo "[pre-push] note: Modules/$name/ exists but is missing from the AGENTS.md structure block" >&2
            drift=1
        fi
    done
    for name in $(grep -o 'Modules/[A-Za-z0-9_]*/' AGENTS.md | sed 's|^Modules/||; s|/$||' | sort -u); do
        if [ ! -d "Modules/$name" ]; then
            echo "[pre-push] note: AGENTS.md lists Modules/$name/ but it no longer exists" >&2
            drift=1
        fi
    done
    if [ "$drift" -eq 1 ]; then
        echo "[pre-push] (non-blocking) AGENTS.md Structure block is out of date — update it." >&2
    fi
fi

# Each tool gates independently: a machine missing one tool still runs the
# others (a missing busted used to skip lint too — fixed 2026-07-01).

# Blocking since 2026-06-11: the luacheck warning baseline is zero.
# luacheck ships as a luarocks .bat since 2026-07-03 (Smart App Control
# blocks the standalone exe) — resolve both forms, same as busted below.
luacheck_bin="$(command -v luacheck || command -v luacheck.bat || true)"
echo "[pre-push] luacheck…"
if [ -n "$luacheck_bin" ]; then
    if ! "$luacheck_bin" . -q; then
        echo "[pre-push] BLOCKED: luacheck warnings. Fix them, or override with: git push --no-verify" >&2
        exit 1
    fi
else
    echo "[pre-push] luacheck not on PATH — skipping lint. (CI will still lint.)" >&2
fi

# Windows: luarocks generates only .bat launchers, which bash's plain
# `command -v busted` cannot resolve — check both forms.
busted_bin="$(command -v busted || command -v busted.bat || true)"

if [ -n "$busted_bin" ]; then
    echo "[pre-push] busted…"
    if ! "$busted_bin"; then
        echo "[pre-push] BLOCKED: tests failed. Fix them, or override with: git push --no-verify" >&2
        exit 1
    fi
else
    echo "[pre-push] busted not on PATH — skipping tests. See dev/README.md to set up." >&2
    echo "[pre-push] (push allowed; CI will still run the suite.)" >&2
fi

# .luacheckrc drift vs the local WoW API reference (non-blocking, quiet when
# clean). Local-only by construction: CI never has the gitignored symlink.
if command -v lua >/dev/null 2>&1 \
    && [ -f dev/scripts/check-luacheckrc-drift.lua ] \
    && [ -e .wow-api-reference/Interface/AddOns/Blizzard_APIDocumentationGenerated ]; then
    if ! lua dev/scripts/check-luacheckrc-drift.lua >/dev/null 2>&1; then
        echo "[pre-push] note (non-blocking): .luacheckrc drifts from the API reference — run: lua dev/scripts/check-luacheckrc-drift.lua" >&2
    fi
fi

echo "[pre-push] OK"
