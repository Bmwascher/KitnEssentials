#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════════╗
# ║  dev/githooks/pre-push                                   ║
# ║  Local gate so bad code never reaches a pushed branch.   ║
# ╚══════════════════════════════════════════════════════════╝
#
# Opt in once (per clone / per worktree):
#     git config core.hooksPath dev/githooks
#
# Requires lua + luacheck (+ busted for main pushes) on PATH. On Windows, ensure the luarocks
# bin dir (e.g. %APPDATA%\luarocks\bin) is on PATH — see dev/README.md.
# Override a single push with:  git push --no-verify
set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root" || exit 1

# Buffer the pushed refs FIRST: git feeds one line per ref on stdin,
# consumable exactly once, and both the tag guard and the attestation
# check below need them (a second `while read` would see nothing).
pushed_refs=()
while IFS= read -r _line; do pushed_refs+=("$_line"); done

# Release-tag guard (blocking): a v* tag must point at the release commit —
# subject "vX.Y.Z: …". Tagging a merge/feature commit instead broke the
# naming convention for v1.17.0, v3.0.0, v3.0.3. Override a deliberate
# exception with: git push --no-verify
for _line in "${pushed_refs[@]}"; do
    read -r _lref _lsha _rref _rsha <<< "$_line"
    case "$_rref" in refs/tags/v*) ;; *) continue ;; esac
    # skip tag deletions (local sha is all zeros)
    case "$_lsha" in *[!0]*) ;; *) continue ;; esac
    tag="${_rref#refs/tags/}"
    subject="$(git log -1 --format=%s "$_lsha" 2>/dev/null)"
    case "$subject" in
        "$tag:"*) ;;
        *)
            echo "[pre-push] BLOCKED: $tag points at '$subject' — tag the release commit ('$tag: …') instead, or override with: git push --no-verify" >&2
            exit 1
            ;;
    esac
    # Second clause of the release invariant: the tagged commit must sit on main.
    if ! git merge-base --is-ancestor "$_lsha" refs/heads/main 2>/dev/null; then
        echo "[pre-push] BLOCKED: $tag targets a commit not on main — merge to main first, then tag. Override: git push --no-verify" >&2
        exit 1
    fi
done

# Comment and message guards over everything this push would publish
# (blocking): the commit-time hooks are skippable with --no-verify, other
# tools commit without them at all, and a tag push carries commits of its own.
# Scanned one commit at a time, because a comment added in one commit and
# removed in a later one never appears in a range diff yet still publishes.
ng_lib="$repo_root/dev/githooks/lib/name-guards.sh"
if [ ! -f "$ng_lib" ]; then
    echo "[pre-push] BLOCKED: missing $ng_lib - the guards cannot run." >&2
    exit 1
fi
# shellcheck source=/dev/null
. "$ng_lib"
ng_load pre-push stems shorts compat provenance namesCI namesCS || exit 1

# git names the push destination in $1 and its location in $2. Query the
# location, since a remote whose pushurl differs from its fetch url would be
# answered by the wrong host; print the name, since an https location can
# carry credentials.
_dest="${2:-${1:-}}"
_dest_label="${1:-$_dest}"
# Pushing to a bare URL makes both arguments that URL, so there is no safe
# name to print.
case "$_dest_label" in *://*|*@*) _dest_label="the destination" ;; esac
_fallback=()
_fallback_ready=0

# What to subtract for a ref whose advertised sha this clone does not hold.
# Local tracking refs go stale when a branch is deleted or rewritten remotely,
# and a stale ref subtracts commits the remote never had, so ask the remote
# what it carries now. Only shas held locally can be subtracted, so the answer
# over-scans at worst, and a remote that cannot be reached subtracts nothing
# at all rather than falling back to the stale refs this exists to avoid.
# Computed once, and only when a ref needs it: it is a network round trip to
# the host this push is about to contact anyway.
ng_fallback_excl() {
    [ "$_fallback_ready" -eq 0 ] || return 0
    _fallback_ready=1
    local refs sha rest
    if ! refs="$(git ls-remote --heads --tags "$_dest" 2>/dev/null)"; then
        echo "[pre-push] $_dest_label did not answer — scanning the full history reachable from each ref." >&2
        return 0
    fi
    while read -r sha rest; do
        [ -n "$sha" ] || continue
        git cat-file -e "$sha^{commit}" 2>/dev/null && _fallback+=("$sha")
    done <<< "$refs"
}

for _line in "${pushed_refs[@]}"; do
    read -r _lref _lsha _rref _rsha <<< "$_line"
    # skip deletions (local sha is all zeros)
    case "$_lsha" in *[!0]*) ;; *) continue ;; esac
    # The advertised remote sha bounds the scan only when this clone holds
    # that object: force-pushing over an unfetched tip would otherwise make
    # every git call fail and read as a clean scan.
    _excl=()
    case "$_rsha" in
        *[!0]*) git cat-file -e "$_rsha^{commit}" 2>/dev/null && _excl=("$_rsha") ;;
    esac
    if [ "${#_excl[@]}" -eq 0 ]; then
        ng_fallback_excl
        _excl=(${_fallback[@]+"${_fallback[@]}"})
    fi
    if ! _new="$(git rev-list "$_lsha" --not ${_excl[@]+"${_excl[@]}"})"; then
        echo "[pre-push] BLOCKED: could not list the commits $_lref would publish." >&2
        exit 1
    fi
    [ -n "$_new" ] || continue
    _count="$(printf '%s\n' "$_new" | wc -l)"
    if [ "$_count" -gt 200 ]; then
        echo "[pre-push] scanning $_count commits for $_lref — this takes a moment." >&2
    fi
    for _c in $_new; do
        if ! _short="$(git rev-parse --short "$_c")" \
            || ! _comments="$(ng_commit_comments "$_c")" \
            || ! _dev_comments="$(ng_commit_comments "$_c" dev)" \
            || ! _msg="$(git log -1 --format='%s%n%b' "$_c")"; then
            echo "[pre-push] BLOCKED: could not read commit $_c." >&2
            exit 1
        fi
        if ! ng_scan_comments pre-push "comments added in commit $_short" "$_comments" \
            || ! ng_scan_comments pre-push "dev-script comments added in commit $_short" "$_dev_comments" dev; then
            echo "[pre-push] Fix the comments and amend or rebase, or override a deliberate exception with: git push --no-verify" >&2
            exit 1
        fi
        if ! ng_scan_text pre-push "commit $_short" "$_msg"; then
            echo "[pre-push] Reword it with an interactive rebase, or override a deliberate exception with: git push --no-verify" >&2
            exit 1
        fi
    done
done

# Per-merge bump check (non-blocking): a main push whose range touches addon
# .lua/.xml with no .toc or CHANGELOG.md change is usually a merge that
# skipped the version bump and changelog entry (family AGENTS.md, Git).
# Internal Only merges legitimately skip both, so this only notes.
for _line in "${pushed_refs[@]}"; do
    read -r _lref _lsha _rref _rsha <<< "$_line"
    [ "$_rref" = "refs/heads/main" ] || continue
    case "$_lsha" in *[!0]*) ;; *) continue ;; esac
    case "$_rsha" in *[!0]*) ;; *) continue ;; esac
    git cat-file -e "$_rsha^{commit}" 2>/dev/null || continue
    _src="$(git diff --name-only "$_rsha".."$_lsha" -- '*.lua' '*.xml' ':(exclude)dev/' 2>/dev/null | head -1)"
    [ -n "$_src" ] || continue
    _bump="$(git diff --name-only "$_rsha".."$_lsha" -- KitnEssentials.toc CHANGELOG.md 2>/dev/null | head -1)"
    if [ -z "$_bump" ]; then
        echo "[pre-push] note (non-blocking): main push touches addon .lua/.xml with no KitnEssentials.toc or CHANGELOG.md change - add the per-merge bump and changelog entry unless the change is Internal Only." >&2
    fi
done

# AGENTS.md drift check (non-blocking): warn when Modules/ on disk and the
# AGENTS.md Structure block disagree, in either direction. AGENTS.md is
# gitignored, so read it from the working tree.
if [ -f AGENTS.md ] && [ -d Modules ]; then
    drift=0
    for d in Modules/*/; do
        name="$(basename "$d")"
        if ! grep -q "Modules/$name/" AGENTS.md; then
            echo "[pre-push] note: Modules/$name/ exists but is missing from the AGENTS.md structure block" >&2
            drift=1
        fi
    done
    for name in $(grep -o 'Modules/[A-Za-z0-9_]*/' AGENTS.md | sed 's|^Modules/||; s|/$||' | sort -u); do
        if [ ! -d "Modules/$name" ]; then
            echo "[pre-push] note: AGENTS.md lists Modules/$name/ but it no longer exists" >&2
            drift=1
        fi
    done
    if [ "$drift" -eq 1 ]; then
        echo "[pre-push] (non-blocking) AGENTS.md Structure block is out of date — update it." >&2
    fi
fi

# Each tool gates independently: on a feature push a machine missing one
# tool still runs the others. A push to main stops at the first missing tool.

# A push to main tests the pushed commit itself and refuses a missing tool:
# the admin role bypasses the ruleset's required checks, so that push lands
# before CI runs. luacheck and busted always run in a full temporary
# checkout of that commit, so no working-tree state (local edits, untracked
# files, sparse or assume-unchanged entries) reaches them. Feature refs lint
# the working tree, and CI checks their commits on push.
main_sha=""
for _line in "${pushed_refs[@]}"; do
    read -r _lref _lsha _rref _rsha <<< "$_line"
    case "$_lsha" in *[!0]*) ;; *) continue ;; esac
    [ "$_rref" = "refs/heads/main" ] && main_sha="$_lsha"
done
gate_dir="$repo_root"
names_file=""
# Removes only the checkout this hook made (a failed add may have left a
# registration or files); the mktemp folder name finds its registration.
cleanup() {
    [ -n "$names_file" ] && rm -f "$names_file"
    [ "$gate_dir" = "$repo_root" ] && return
    git -C "$repo_root" worktree remove --force "$gate_dir" >/dev/null 2>&1 || rm -rf "$gate_dir"
    if [ -e "$gate_dir" ] || git -C "$repo_root" worktree list --porcelain | grep -qF "/$(basename "$gate_dir")"; then
        echo "[pre-push] note: could not fully remove the temporary checkout $gate_dir; delete it, then check: git worktree list" >&2
    fi
}
trap cleanup EXIT
if [ -n "$main_sha" ]; then
    gate_dir="$(mktemp -d)"
    if ! git -c core.sparseCheckout=false worktree add -q --detach "$gate_dir" "$main_sha"; then
        echo "[pre-push] BLOCKED: could not check out $main_sha to test it. Override with: git push --no-verify" >&2
        exit 1
    fi
    echo "[pre-push] testing the pushed main commit in a temporary checkout…"
fi

# Blocking since 2026-06-11: the luacheck warning baseline is zero.
# luacheck ships as a luarocks .bat since 2026-07-03 (Smart App Control
# blocks the standalone exe) — resolve both forms, same as busted below.
# Lints only the Lua files each ref changes, in that ref's tree (main: the
# gate tree; other refs: the working tree); CI lints the whole tree. Any
# .luacheckrc change, a range git cannot read (no main to diff a new branch
# against, a remote sha this clone lacks), a changed file the tree lacks, or
# an over-long argument list lints that tree whole.
bytelen() { local LC_ALL=C; _len=${#1}; }
main_all=0; main_files=(); main_len=0
other_all=0; other_files=(); other_len=0
names_file="$(mktemp)"
for _line in "${pushed_refs[@]}"; do
    read -r _lref _lsha _rref _rsha <<< "$_line"
    case "$_lsha" in *[!0]*) ;; *) continue ;; esac
    if [ "$_rref" = "refs/heads/main" ]; then _tree="$gate_dir"; _bucket=main; else _tree="$repo_root"; _bucket=other; fi
    case "$_rsha" in
        *[!0]*) _base="$_rsha" ;;
        *) _base="$(git merge-base "$_lsha" refs/remotes/origin/main 2>/dev/null || true)" ;;
    esac
    if [ -z "$_base" ] || ! git diff --name-status --no-renames -z "$_base" "$_lsha" > "$names_file" 2>/dev/null; then
        eval "${_bucket}_all=1"
        continue
    fi
    mapfile -d '' _fields < "$names_file"
    for ((_i = 0; _i + 1 < ${#_fields[@]}; _i += 2)); do
        _s="${_fields[_i]}"
        _f="${_fields[_i + 1]}"
        case "$_f" in
            .luacheckrc) eval "${_bucket}_all=1" ;;
            *.lua)
                [ "$_s" = D ] && continue
                if [ ! -f "$_tree/$_f" ]; then
                    eval "${_bucket}_all=1"
                else
                    bytelen "$_f"
                    if [ "$_bucket" = main ]; then
                        main_files+=("./$_f"); main_len=$((main_len + _len + 5))
                    else
                        other_files+=("./$_f"); other_len=$((other_len + _len + 5))
                    fi
                fi
                ;;
        esac
    done
done
# cmd.exe caps the luacheck.bat command line at 8191 UTF-16 units; each path
# costs its UTF-8 byte length (never fewer than its UTF-16 units) plus "./",
# two quotes and a space.
[ "$main_len" -gt 7000 ] && main_all=1
[ "$other_len" -gt 7000 ] && other_all=1

# lint_tree <dir> <whole-tree flag> <label> [files...]
lint_tree() {
    local dir="$1" all="$2" label="$3"
    shift 3
    local args=()
    if [ "$all" -eq 1 ]; then
        echo "[pre-push] luacheck ($label, whole tree)…"
        args=(.)
    elif [ "$#" -gt 0 ]; then
        mapfile -d '' args < <(printf '%s\0' "$@" | LC_ALL=C sort -zu)
        echo "[pre-push] luacheck ($label, ${#args[@]} changed files)…"
    else
        return 0
    fi
    if ! (cd "$dir" && "$luacheck_bin" -q "${args[@]}"); then
        echo "[pre-push] BLOCKED: luacheck warnings. Fix them, or override with: git push --no-verify" >&2
        exit 1
    fi
}

luacheck_bin="$(command -v luacheck || command -v luacheck.bat || true)"
if [ -z "$luacheck_bin" ]; then
    if [ -n "$main_sha" ]; then
        echo "[pre-push] BLOCKED: luacheck not on PATH, and a push to main lands before CI lints it. See dev/README.md, or override with: git push --no-verify" >&2
        exit 1
    fi
    echo "[pre-push] luacheck not on PATH — skipping lint. (CI will still lint.)" >&2
else
    lint_tree "$gate_dir" "$main_all" "main" "${main_files[@]}"
    lint_tree "$repo_root" "$other_all" "working tree" "${other_files[@]}"
fi

# Windows: luarocks generates only .bat launchers, which bash's plain
# `command -v busted` cannot resolve — check both forms.
busted_bin="$(command -v busted || command -v busted.bat || true)"

if [ -n "$main_sha" ]; then
    if [ -z "$busted_bin" ]; then
        echo "[pre-push] BLOCKED: busted not on PATH, and a push to main lands before CI tests it. See dev/README.md, or override with: git push --no-verify" >&2
        exit 1
    fi
    echo "[pre-push] busted…"
    if ! (cd "$gate_dir" && "$busted_bin"); then
        echo "[pre-push] BLOCKED: tests failed. Fix them, or override with: git push --no-verify" >&2
        exit 1
    fi
fi

# wowlua-ls type and secret-value diagnostics (blocking; the warning
# baseline is zero). The binary is a local install in KitnDev/tools, so
# exit 3 (cannot run) skips with a note.
if command -v pwsh >/dev/null 2>&1 && [ -f dev/scripts/wowlua-check.ps1 ]; then
    echo "[pre-push] wowlua-ls…"
    pwsh -NoProfile -NonInteractive -File dev/scripts/wowlua-check.ps1
    wl_rc=$?
    if [ "$wl_rc" -eq 1 ]; then
        echo "[pre-push] BLOCKED: wowlua-ls warnings. Fix them, or override with: git push --no-verify" >&2
        exit 1
    elif [ "$wl_rc" -eq 3 ]; then
        echo "[pre-push] wowlua-ls unavailable here — skipping. (Install it with: pwsh dev/scripts/update-wowlua-ls.ps1; the checker's own note is above.)" >&2
    fi
fi

# .luacheckrc drift vs the local WoW API reference (non-blocking, quiet when
# clean). Local-only by construction: CI never has the gitignored symlink.
if command -v lua >/dev/null 2>&1 \
    && [ -f dev/scripts/check-luacheckrc-drift.lua ] \
    && [ -e .wow-api-reference/Interface/AddOns/Blizzard_APIDocumentationGenerated ]; then
    if ! lua dev/scripts/check-luacheckrc-drift.lua >/dev/null 2>&1; then
        echo "[pre-push] note (non-blocking): .luacheckrc drifts from the API reference — run: lua dev/scripts/check-luacheckrc-drift.lua" >&2
    fi
fi

# Retail-only API in Forever-loaded files (non-blocking, quiet when clean).
# Local-only for the same reason; the script skips itself without the clones.
if command -v lua >/dev/null 2>&1 \
    && [ -f dev/scripts/check-forever-api.lua ] \
    && [ -e .wow-api-reference/Interface/AddOns/Blizzard_APIDocumentationGenerated ]; then
    lua dev/scripts/check-forever-api.lua >/dev/null 2>&1
    forever_rc=$?
    if [ "$forever_rc" -eq 1 ]; then
        echo "[pre-push] note (non-blocking): a Forever-loaded file uses a Retail-only API or global — run: lua dev/scripts/check-forever-api.lua" >&2
    elif [ "$forever_rc" -ne 0 ]; then
        echo "[pre-push] note (non-blocking): the Forever API check could not run — run: lua dev/scripts/check-forever-api.lua" >&2
    fi
fi

# References/ folder rule (non-blocking, quiet when clean). Local-only: the
# tree is gitignored, so CI never sees it.
if command -v lua >/dev/null 2>&1 \
    && [ -f dev/scripts/check-references-folders.lua ] \
    && [ -d References ]; then
    if ! lua dev/scripts/check-references-folders.lua >/dev/null 2>&1; then
        echo "[pre-push] note (non-blocking): References/ breaks the folder rule — run: lua dev/scripts/check-references-folders.lua" >&2
    fi
fi

# Process-artifact retention rule (non-blocking, quiet when clean). Local-only:
# every root it checks is gitignored.
if command -v pwsh >/dev/null 2>&1 \
    && [ -f dev/scripts/check-artifact-retention.ps1 ] \
    && [ -d dev/docs ]; then
    retention_out=$(pwsh -NoProfile -NonInteractive -File dev/scripts/check-artifact-retention.ps1 -Soft 2>/dev/null | tr -d '\r')
    if [ "$retention_out" != "[retention] OK" ]; then
        echo "[pre-push] note (non-blocking): process-artifact retention findings:" >&2
        printf '%s\n' "$retention_out" >&2
    fi
fi

echo "[pre-push] OK"
