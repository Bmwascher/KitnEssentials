#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════════╗
# ║  dev/githooks/pre-push                                   ║
# ║  Local gate so bad code never reaches a pushed branch.   ║
# ╚══════════════════════════════════════════════════════════╝
#
# Opt in once (per clone / per worktree):
#     git config core.hooksPath dev/githooks
#
# Requires lua + busted + luacheck on PATH. On Windows, ensure the luarocks
# bin dir (e.g. %APPDATA%\luarocks\bin) is on PATH — see dev/README.md.
# Override a single push with:  git push --no-verify
set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root" || exit 1

# AGENTS.md drift check (non-blocking): warn when Modules/ on disk and the
# AGENTS.md Structure block disagree, in either direction. AGENTS.md is
# gitignored, so read it from the working tree. Runs before the busted
# early-exit so the note always prints.
if [ -f AGENTS.md ] && [ -d Modules ]; then
    drift=0
    for d in Modules/*/; do
        name="$(basename "$d")"
        if ! grep -q "Modules/$name/" AGENTS.md; then
            echo "[pre-push] note: Modules/$name/ exists but is missing from the AGENTS.md structure block" >&2
            drift=1
        fi
    done
    for name in $(grep -o 'Modules/[A-Za-z0-9_]*/' AGENTS.md | sed 's|^Modules/||; s|/$||' | sort -u); do
        if [ ! -d "Modules/$name" ]; then
            echo "[pre-push] note: AGENTS.md lists Modules/$name/ but it no longer exists" >&2
            drift=1
        fi
    done
    if [ "$drift" -eq 1 ]; then
        echo "[pre-push] (non-blocking) AGENTS.md Structure block is out of date — update it." >&2
    fi
fi

# Windows: luarocks generates only busted.bat, which bash's plain
# `command -v busted` cannot resolve — check both forms. (.exe tools like
# luacheck.exe resolve automatically under git's msys bash.)
busted_bin="$(command -v busted || command -v busted.bat || true)"

if [ -z "$busted_bin" ]; then
    echo "[pre-push] busted not on PATH — skipping tests. See dev/README.md to set up." >&2
    echo "[pre-push] (push allowed; CI will still run the suite.)" >&2
    exit 0
fi

# Blocking since 2026-06-11: the luacheck warning baseline is zero.
echo "[pre-push] luacheck…"
if command -v luacheck >/dev/null 2>&1; then
    if ! luacheck . -q; then
        echo "[pre-push] BLOCKED: luacheck warnings. Fix them, or override with: git push --no-verify" >&2
        exit 1
    fi
else
    echo "[pre-push] luacheck not on PATH — skipping lint. (CI will still lint.)" >&2
fi

echo "[pre-push] busted…"
if ! "$busted_bin"; then
    echo "[pre-push] BLOCKED: tests failed. Fix them, or override with: git push --no-verify" >&2
    exit 1
fi

echo "[pre-push] OK"
