#!/usr/bin/env bash
# Commit-message guard: upstream/reference addon names are banned from commit
# messages (family AGENTS.md git rules) — provenance is a release-visible
# brand leak. Violated 7 times before this hook existed; three of those needed
# history rewrites or force-pushes of main.
# Also blocks AI-attribution trailers (family rule: never append them).
# Deliberate exception: git commit --no-verify
set -uo pipefail

msg_file="$1"
# Strip comment lines; scan subject and body both (violations landed in both).
msg="$(grep -v '^#' "$msg_file" || true)"

# Word-bounded, case-insensitive. ElvUI is NOT listed: it is a public
# compatibility target and legitimately appears in user-facing entries.
# "eui"/"aes"/"nui" are the shorthand forms that actually shipped in the
# historical violations.
upstream='atrocity|atrocityessentials|norsken|norskenui|ellesmere|ellesmereui|exwind|exwindtools|exboss|windtools|highonhaste|augbufftracker|aes|eui|nui'
if hit="$(printf '%s\n' "$msg" | grep -iwoE "$upstream" | head -1)"; then
    if [ -n "$hit" ]; then
        echo "[commit-msg] BLOCKED: commit message contains upstream addon name '$hit'." >&2
        echo "[commit-msg] Reference provenance belongs in local docs, never in published history. Reword the message, or override a deliberate exception with: git commit --no-verify" >&2
        exit 1
    fi
fi

if printf '%s\n' "$msg" | grep -qE '^(Co-Authored-By:|Claude-Session)'; then
    echo "[commit-msg] BLOCKED: AI-attribution trailer in commit message (family rule: never append them). Remove it, or override with: git commit --no-verify" >&2
    exit 1
fi

exit 0
