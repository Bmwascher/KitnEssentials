#!/usr/bin/env bash
# Commit-message guard: upstream/reference addon names are banned from commit
# messages (family AGENTS.md git rules) — provenance is a release-visible
# brand leak. Violated 7 times before this hook existed; three of those needed
# history rewrites or force-pushes of main.
# Also blocks AI-attribution trailers (family rule: never append them).
# Deliberate exception: git commit --no-verify
set -uo pipefail

ng_lib="$(dirname "$0")/lib/name-guards.sh"
if [ ! -f "$ng_lib" ]; then
    echo "[commit-msg] BLOCKED: missing $ng_lib — the guards cannot run." >&2
    exit 1
fi
# shellcheck source=/dev/null
. "$ng_lib"

msg_file="$1"
# Scan the whole file, comment lines included: -m messages keep '#' lines
# under git's default cleanup, so stripping them would open a false-negative
# hole; a '#' comment line tripping the guard on an editor commit is rare and
# has the --no-verify escape. But stop at the scissors line — `git commit -v`
# appends the full staged diff below it, which git never commits and which
# legitimately contains addon names (conflict-registry code).
msg="$(sed '/^# -\{8,\} >8 -\{8,\}/q' "$msg_file")"

ng_load commit-msg stems shorts compat provenance || exit 1
if ! ng_scan_text commit-msg "commit message" "$msg"; then
    echo "[commit-msg] Reword the message, or override a deliberate exception with: git commit --no-verify" >&2
    exit 1
fi

# Trailers may be indented; footers such as "Generated with Claude Code" and a
# Signed-off-by naming an agent are attribution too. The robot emoji is given
# as bytes so the script stays ASCII.
robot=$'\xF0\x9F\xA4\x96'
if printf '%s\n' "$msg" | grep -qiE "^[[:space:]]*(co-authored-by:|claude-session|generated with claude|signed-off-by:.*\b(claude|codex)\b)|$robot"; then
    echo "[commit-msg] BLOCKED: AI-attribution trailer in commit message (family rule: never append them). Remove it, or override with: git commit --no-verify" >&2
    exit 1
fi

# Subjects are lowercase imperative (family AGENTS.md git rules). Release
# commits start with a lowercase v and pass; git's default "Merge branch" and
# "Revert" subjects do not, so merges and reverts take -m with a real subject.
subject="$(printf '%s\n' "$msg" | grep -v '^#' | grep -m1 .)"
if printf '%s' "$subject" | grep -qE '^[A-Z]'; then
    echo "[commit-msg] BLOCKED: subject starts uppercase ('$subject'). Family rule: lowercase, imperative mood. Reword (git commit --amend -m ...), or override a deliberate exception with: git commit --no-verify" >&2
    exit 1
fi

exit 0
