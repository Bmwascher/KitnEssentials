#!/usr/bin/env bash
# Pre-commit guard: the comment rules (KE AGENTS.md "Comments: lean, and
# impersonal") ban personal/agent names, upstream addon names, plan-step
# references, dates, and review/session history from shipped source comments.
# Broken 8+ times before this hook; every instance was greppable.
# Deliberate exception: git commit --no-verify
set -uo pipefail

ng_lib="$(dirname "$0")/lib/name-guards.sh"
if [ ! -f "$ng_lib" ]; then
    echo "[pre-commit] BLOCKED: missing $ng_lib — the guards cannot run." >&2
    exit 1
fi
# shellcheck source=/dev/null
. "$ng_lib"

comments="$(ng_added_comments --cached)"
[ -n "$comments" ] || exit 0

ng_load pre-commit stems compat provenance namesCI namesCS || exit 1
if ! ng_scan_comments pre-commit "staged addon-source comments" "$comments"; then
    echo "[pre-commit] Fix the lines, or override a deliberate exception with: git commit --no-verify" >&2
    exit 1
fi
exit 0
