{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": [
              "-NoProfile",
              "-NonInteractive",
              "-Command",
              "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/agents-mirror-sync.ps1\"; exit $LASTEXITCODE"
            ],
            "timeout": 30,
            "statusMessage": "agents mirror sync"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": [
              "-NoProfile",
              "-NonInteractive",
              "-Command",
              "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/references-check.ps1\"; exit $LASTEXITCODE"
            ],
            "timeout": 30,
            "statusMessage": "references folder check"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": [
              "-NoProfile",
              "-NonInteractive",
              "-Command",
              "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/retention-check.ps1\"; exit $LASTEXITCODE"
            ],
            "timeout": 60,
            "statusMessage": "artifact retention check"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": [
              "-NoProfile",
              "-NonInteractive",
              "-Command",
              "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/lib-update-check.ps1\"; exit $LASTEXITCODE"
            ],
            "timeout": 45,
            "statusMessage": "library update check"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": [
              "-NoProfile",
              "-NonInteractive",
              "-Command",
              "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/program-recovery.ps1\"; exit $LASTEXITCODE"
            ],
            "timeout": 30,
            "statusMessage": "program master recovery card"
          }
        ]
      }
    ]
  }
}
