# KitnEssentials — local-only files. Everything else is tracked; the player
# zip is shaped by .pkgmeta (its `- dev` entry strips all dev tooling), not
# this file. Convention: dev tooling goes in dev/ (tracked), personal notes
# in dev/docs/ (ignored), third-party addon sources in References/ (ignored).

# Claude Code/Codex workspace (config, skills, project instructions)
.claude/
.codex/
.agents/
CLAUDE.md
AGENTS.md
/References/

# Guard word list for the commit-msg/pre-commit hooks: the repo is public,
# and publishing the list leaks the provenance the guards keep out of history.
dev/githooks/upstream-names.local.sh

# Personal dev notes, audits, Superpowers artifacts (local-only by choice)
dev/docs/
.superpowers/

# Editor settings & language-server config (machine-local)
.vscode/
.wowluarc.json

# Symlink to the Blizzard UI source clone.
.wow-api-reference

# luacov output (busted --coverage && luacov) — throwaway, regenerated per run
luacov.stats.out
luacov.report.out

# Python bytecode
__pycache__/
